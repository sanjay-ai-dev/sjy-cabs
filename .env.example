# ═══════════════════════════════════════════════════════════
# SJY Mobility — Environment Configuration
# Copy this file to .env and fill in production values
# ═══════════════════════════════════════════════════════════

# ── PostgreSQL + PostGIS ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sjy_mobility
DB_USER=sjy
DB_PASSWORD=change_me_in_production

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── GPS TCP Server ──
TCP_HOST=0.0.0.0
TCP_PORT=9000

# ── OSRM (Self-Hosted) ──
OSRM_BASE_URL=http://localhost:5000

# ── Ollama LLM (Local) ──
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# ── WhatsApp Business API ──
# BSP: Wati.io or AiSensy
WHATSAPP_VERIFY_TOKEN=sjy_webhook_verify_2026
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_API_TOKEN=your_bsp_api_token
WHATSAPP_BSP=wati  # wati | aisensy | meta

# ── API Server ──
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=https://api.sjy.co.in
TRACKING_BASE_URL=https://t.sjy.co.in

# ── Security ──
SECRET_KEY=generate_a_random_64_char_hex_string
CORS_ORIGINS=["https://sjy.co.in","https://admin.sjy.co.in","https://t.sjy.co.in"]
